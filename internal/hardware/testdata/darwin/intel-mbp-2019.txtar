# A 16-inch MacBook Pro (2019): Intel Core i9, Intel UHD Graphics 630 and a
# Radeon Pro 5500M. sysctl prints only the keys that exist on an Intel Mac.
# Values chosen, not captured.
-- $ sysctl --
hw.memsize: 34359738368
hw.physicalcpu: 8
hw.logicalcpu: 16
machdep.cpu.brand_string: Intel(R) Core(TM) i9-9880H CPU @ 2.30GHz
-- $ sw_vers --
ProductName:		macOS
ProductVersion:		15.7.1
BuildVersion:		24G231
