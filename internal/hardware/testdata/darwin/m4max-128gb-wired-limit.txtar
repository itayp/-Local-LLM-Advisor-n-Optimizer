# A Mac Studio (M4 Max, 128 GB) whose owner raised the GPU cap with
# `sudo sysctl iogpu.wired_limit_mb=120000`. The wired limit, not Metal's
# default, is what the OS enforces. Values chosen, not captured.
-- $ sysctl --
hw.memsize: 137438953472
hw.physicalcpu: 16
hw.logicalcpu: 16
machdep.cpu.brand_string: Apple M4 Max
hw.optional.arm64: 1
sysctl.proc_translated: 0
iogpu.wired_limit_mb: 120000
-- $ sw_vers --
ProductName:		macOS
ProductVersion:		26.6.2
BuildVersion:		25G83
