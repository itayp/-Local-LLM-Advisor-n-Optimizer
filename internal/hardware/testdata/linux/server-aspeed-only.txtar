-- etc/systemd/system/ollama.service --
[Unit]
Description=Ollama Service

[Service]
ExecStart=/usr/local/bin/ollama serve
User=ollama
Environment="PATH=/usr/local/bin:/usr/bin"
-- etc/systemd/system/ollama.service.d/10-models.conf --
[Service]
Environment="OLLAMA_HOST=127.0.0.1" "OLLAMA_MODELS=/srv/ollama/models"
