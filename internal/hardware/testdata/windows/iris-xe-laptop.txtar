# A Windows 11 laptop with only Intel Iris Xe graphics. The PowerShell output
# is in the shape Windows PowerShell 5.1 can produce: a byte-order mark first,
# and one-element arrays unrolled into single values. Values chosen, not
# captured.
-- env --
SystemRoot=C:\Windows
ProgramFiles=C:\Program Files
USERPROFILE=C:\Users\itay
-- exists --
C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe
-- $ powershell -NoProfile --
