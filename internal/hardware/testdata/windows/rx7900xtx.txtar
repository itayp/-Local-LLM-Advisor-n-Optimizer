# Windows 11 with a Radeon RX 7900 XTX (gfx1100, on Ollama's Windows ROCm list).
# AMD's display-class key carries RadeonSoftwareVersion, the number AMD's own
# software shows. Values chosen, not captured.
-- env --
SystemRoot=C:\Windows
ProgramFiles=C:\Program Files
USERPROFILE=C:\Users\itay
-- exists --
C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe
-- $ powershell -NoProfile --
