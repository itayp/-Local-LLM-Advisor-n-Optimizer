# Windows 11 on a desktop whose GeForce card has no NVIDIA driver yet: Windows
# runs it on the Microsoft Basic Display Adapter, and the PCI id still says
# whose card it is. A Remote Desktop display is filtered out. Values chosen,
# not captured.
-- env --
SystemRoot=C:\Windows
ProgramFiles=C:\Program Files
USERPROFILE=C:\Users\itay
-- exists --
C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe
-- $ powershell -NoProfile --
