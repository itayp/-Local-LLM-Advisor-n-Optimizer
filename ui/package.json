{
  "name": "advisor-ui",
  "private": true,
  "version": "0.0.0",
  "description": "Local LLM Advisor & Optimizer — the UI the daemon embeds and serves at http://127.0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
